# --- Database ---
# Pri lokálnom Dockeri nechaj host=127.0.0.1 a port=3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rs
DB_USER=rs_user
DB_PASSWORD=zmen_ma_na_silne_heslo

# --- Spotify ---
# Tieto údaje získaš vytvorením vlastnej aplikácie na:
#   https://developer.spotify.com/dashboard
#
# Postup je v SETUP.md, sekcia 3. Krátka verzia:
#   1. Create app → zaškrtni Web API + Web Playback SDK
#   2. Redirect URI: http://127.0.0.1:3000
#   3. User Management → pridaj svoj Spotify email (kvôli Dev Mode obmedzeniu)
#   4. Basic Information → skopíruj Client ID a Client secret sem nižšie
#
# UPOZORNENIE: SPOTIFY_CLIENT_SECRET je tajný — nikdy ho nezdieľaj ani necommituj!
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Nemeň túto hodnotu — musí sa zhodovať s Redirect URI v Spotify Dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000
